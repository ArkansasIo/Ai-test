SANDBOX_ENABLED=true
SANDBOX_DEFAULT_RUNTIME=node
SANDBOX_DEFAULT_IMAGE=node:24-alpine
SANDBOX_CPU_CORES=2
SANDBOX_MEMORY_MB=1024
SANDBOX_DISK_MB=2048
SANDBOX_TIMEOUT_MS=30000
SANDBOX_MAX_PROCESSES=32
SANDBOX_NETWORK_ENABLED=false
SANDBOX_ALLOW_HOST_FILESYSTEM=false
SANDBOX_ALLOW_PRIVILEGED=false
SANDBOX_WORK_ROOT=/var/lib/ai-test/sandboxes
